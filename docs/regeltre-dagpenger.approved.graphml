    <node id="n647"><data key="label">regel:Oppfyller kravet på unntak for utdanning eller opplæring</data><data key="labels">:Regel</data><data key="navn">Alle(Oppfyller kravet på unntak for utdanning eller opplæring)</data><data key="type">Alle</data><data key="uttrykk">Sjekker om alle Har svart ja på spørsmål om utdanning eller opplæring, Godkjent unntak for utdanning eller opplæring? er sanne</data><data key="regelsett">Utdanning</data></node>
    <node id="n648"><data key="label">regel:Oppfyller krav til utdanning eller opplæring</data><data key="labels">:Regel</data><data key="navn">EnAv(Oppfyller krav til utdanning eller opplæring)</data><data key="type">EnAv</data><data key="uttrykk">Sjekker om minst en av Oppfyller kravet på unntak for utdanning eller opplæring, Har svart nei på spørsmål om utdanning eller opplæring er sanne</data><data key="regelsett">Utdanning</data></node>
    <node id="n649"><data key="label">regel:Bruker er utestengt fra dagpenger</data><data key="labels">:Regel</data><data key="navn">Ekstern(Bruker er utestengt fra dagpenger)</data><data key="type">Ekstern</data><data key="uttrykk">Henter Bruker er utestengt fra dagpenger basert på Prøvingsdato</data><data key="regelsett">Utestengning</data></node>
    <node id="n650"><data key="label">regel:Oppfyller krav til ikke utestengt</data><data key="labels">:Regel</data><data key="navn">IngenAv(Oppfyller krav til ikke utestengt)</data><data key="type">IngenAv</data><data key="uttrykk">Sjekker at ingen av Bruker er utestengt fra dagpenger er sanne</data><data key="regelsett">Utestengning</data></node>
    <node id="n651"><data key="label">regel:Fastsatt arbeidstid per uke før tap</data><data key="labels">:Regel</data><data key="navn">MinstAv(Fastsatt arbeidstid per uke før tap)</data><data key="type">MinstAv</data><data key="uttrykk">Fastsetter Fastsatt arbeidstid per uke før tap til laveste verdi av Maksimal vanlig arbeidstid, Fastsatt vanlig arbeidstid etter ordinær eller verneplikt, Samordnet fastsatt arbeidstid, Ønsket arbeidstid</data><data key="regelsett">Fastsettelse av arbeidstid</data></node>
    <node id="n652"><data key="label">regel:Avtjent verneplikt</data><data key="labels">:Regel</data><data key="navn">Ekstern(Avtjent verneplikt)</data><data key="type">Ekstern</data><data key="uttrykk">Henter Avtjent verneplikt basert på søknadId</data><data key="regelsett">Verneplikt</data></node>
    <node id="n653"><data key="label">regel:Oppfyller kravet til verneplikt</data><data key="labels">:Regel</data><data key="navn">ErSann(Oppfyller kravet til verneplikt)</data><data key="type">ErSann</data><data key="uttrykk">Sjekker om Avtjent verneplikt er sann</data><data key="regelsett">Verneplikt</data></node>
    <node id="n654"><data key="label">regel:Antall G som gis som grunnlag ved verneplikt</data><data key="labels">:Regel</data><data key="navn">Oppslag(Antall G som gis som grunnlag ved verneplikt)</data><data key="type">Oppslag</data><data key="uttrykk">Slår opp gjeldende verdi for Antall G som gis som grunnlag ved verneplikt på Prøvingsdato</data><data key="regelsett">Dagpenger ved verneplikt</data></node>
    <node id="n655"><data key="label">regel:Grunnlag som gis ved verneplikt</data><data key="labels">:Regel</data><data key="navn">Multiplikasjon(Grunnlag som gis ved verneplikt)</data><data key="type">Multiplikasjon</data><data key="uttrykk">Beregner Grunnlag som gis ved verneplikt ved å gange Grunnbeløp for grunnlag med Antall G som gis som grunnlag ved verneplikt</data><data key="regelsett">Dagpenger ved verneplikt</data></node>
    <node id="n656"><data key="label">regel:Periode som gis ved verneplikt</data><data key="labels">:Regel</data><data key="navn">Oppslag(Periode som gis ved verneplikt)</data><data key="type">Oppslag</data><data key="uttrykk">Slår opp gjeldende verdi for Periode som gis ved verneplikt på Prøvingsdato</data><data key="regelsett">Dagpenger ved verneplikt</data></node>
    <node id="n657"><data key="label">regel:Fastsatt vanlig arbeidstid for verneplikt</data><data key="labels">:Regel</data><data key="navn">Oppslag(Fastsatt vanlig arbeidstid for verneplikt)</data><data key="type">Oppslag</data><data key="uttrykk">Slår opp gjeldende verdi for Fastsatt vanlig arbeidstid for verneplikt på Prøvingsdato</data><data key="regelsett">Dagpenger ved verneplikt</data></node>
