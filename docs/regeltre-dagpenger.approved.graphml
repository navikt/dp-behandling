    <node id="n341"><data key="label">SvangerskapsrelaterteSykepenger</data><data key="labels">:Avklaring</data><data key="kode">SvangerskapsrelaterteSykepenger</data><data key="tittel">Svangerskapsrelaterte sykepenger</data><data key="beskrivelse">Søker har fått utbetalt sykepenger. Sjekk om sykepengene er svangerskapsrelaterte, 
og skal være med i inntektsgrunnlaget for vurderingen av minste arbeidsinntekt.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n342"><data key="label">InntektNesteKalendermåned</data><data key="labels">:Avklaring</data><data key="kode">InntektNesteKalendermåned</data><data key="tittel">Inntekt neste måned</data><data key="beskrivelse">Søker har inntekt som tilhører neste kalendermåned. 
Sjekk om det er tilstrekkelige inntekter til at utfallet eller dagpengegrunnlaget vil endre seg i neste kalendermåned.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n343"><data key="label">Omgjøring uten klage</data><data key="labels">:Regelsett</data><data key="navn">Omgjøring uten klage</data><data key="type">Prosess</data><data key="hjemmel">§ 6-35. Omgjøring av vedtak uten klage</data><data key="hjemmelUrl">https://lovdata.no/nav/andre-rettskilder/Forvaltningsloven/kapVI/§6-35</data></node>
    <node id="n344"><data key="label">HarSvartPåOmgjøringUtenKlage</data><data key="labels">:Avklaring</data><data key="kode">HarSvartPåOmgjøringUtenKlage</data><data key="tittel">Omgjøring etter forvaltningsloven § 35</data><data key="beskrivelse">Du må velge aktuell bokstav i forvaltningsloven § 35, og begrunne. Trykk på linken for å komme til prosessregler og gi begrunnelse.</data><data key="kanKvitteres">false</data><data key="kanAvbrytes">true</data></node>
    <node id="n345"><data key="label">Skal omgjøring uten klage vurderes?</data><data key="labels">:Regelsett</data><data key="navn">Skal omgjøring uten klage vurderes?</data><data key="type">Prosess</data><data key="hjemmel">§ 6-35. Skal omgjøring uten klage vurderes?</data><data key="hjemmelUrl">https://lovdata.no/nav/andre-rettskilder/Forvaltningsloven/kapVI/§6-35</data></node>
    <node id="n346"><data key="label">Skal vedtaket omgjøres etter forvaltningsloven § 35?</data><data key="labels">:Opplysning:Grunnlag</data><data key="opplysningId">019f7004-6585-7728-88b4-256210d72b93</data><data key="regelsett">Skal omgjøring uten klage vurderes?</data><data key="regelsettType">Prosess</data><data key="regelType">Utgangspunkt</data><data key="datatype">Boolsk</data><data key="gyldighetsperiodeStrategi">minsteMulige</data><data key="overlappStrategi">KUN_SISTE</data><data key="kategori">Prosess</data><data key="formål">Regel</data><data key="behovId">Skal vedtaket omgjøres etter forvaltningsloven § 35?</data></node>
    <node id="n347"><data key="label">SkalOmgjøringUtenKlageVurderes</data><data key="labels">:Avklaring</data><data key="kode">SkalOmgjøringUtenKlageVurderes</data><data key="tittel">Skal vedtaket omgjøres etter forvaltningsloven § 35?</data><data key="beskrivelse">Hvis du ikke skal omgjøre etter forvaltningsloven § 35, må du begrunne hvorfor for å lukke avklaringen. 
Hvis du skal omgjøre må du klikke på linken og velge årsak til omgjøringen.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n348"><data key="label">Opphold</data><data key="labels">:Regelsett</data><data key="navn">Opphold</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-2. Opphold i Norge</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-2</data></node>
    <node id="n349"><data key="label">Bostedsland</data><data key="labels">:Avklaring</data><data key="kode">Bostedsland</data><data key="tittel">Bostedsland er ikke Norge</data><data key="beskrivelse">Søker har oppgitt bostedsland som ikke er i Norge.
Sjekk om bruker er unntatt vilkårene for opphold i Norge.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
