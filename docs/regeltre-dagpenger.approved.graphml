    <node id="n377"><data key="label">Søknad</data><data key="labels">:Regelsett</data><data key="navn">Søknad</data><data key="type">Vilkår</data><data key="hjemmel">§ 22-13. Frister for framsetting av krav, virkningstidspunkt og etterbetaling</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§22-13</data></node>
    <node id="n378"><data key="label">Søknadstidspunkt</data><data key="labels">:Regelsett</data><data key="navn">Søknadstidspunkt</data><data key="type">Fastsettelse</data><data key="hjemmel">§ 3-1. Søknadstidspunkt</data></node>
    <node id="n379"><data key="label">VirkningstidspunktForLangtFramItid</data><data key="labels">:Avklaring</data><data key="kode">VirkningstidspunktForLangtFramItid</data><data key="tittel">Prøvingsdato ligger for langt fram i tid</data><data key="beskrivelse">Prøvingsdato ligger mer enn 14 dager fram i tid.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n380"><data key="label">SjekkPrøvingsdato</data><data key="labels">:Avklaring</data><data key="kode">SjekkPrøvingsdato</data><data key="tittel">Prøvingsdato</data><data key="beskrivelse">Sjekk at valgt prøvingsdato er riktig.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n381"><data key="label">Tap av arbeidsinntekt og arbeidstid</data><data key="labels">:Regelsett</data><data key="navn">Tap av arbeidsinntekt og arbeidstid</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-3. Tap av arbeidsinntekt og arbeidstid</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-3</data></node>
    <node id="n382"><data key="label">TapAvArbeidsinntektOgArbeidstid</data><data key="labels">:Avklaring</data><data key="kode">TapAvArbeidsinntektOgArbeidstid</data><data key="tittel">Du må velge kun én beregningsregel for tap av arbeidsinntekt og arbeidstid</data><data key="beskrivelse">Kun én beregningsregel kan være gyldig til enhver tid. 
Velg en av &quot;Arbeidstid siste 6 måneder&quot;, &quot;Arbeidstid siste 12 måneder&quot; eller &quot;Arbeidstid siste 36 måneder&quot;.</data><data key="kanKvitteres">false</data><data key="kanAvbrytes">true</data></node>
    <node id="n383"><data key="label">BeregnetArbeidstid</data><data key="labels">:Avklaring</data><data key="kode">BeregnetArbeidstid</data><data key="tittel">Arbeidstid</data><data key="beskrivelse">Sjekk om vanlig arbeidstid er korrekt og at det er brukt riktig beregningsregel. 
Du må også sjekke om ny vanlig arbeidstid er korrekt.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n384"><data key="label">Tidsbegrenset bortfall</data><data key="labels">:Regelsett</data><data key="navn">Tidsbegrenset bortfall</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-20. Tidsbegrenset bortfall av dagpenger</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-20</data></node>
    <node id="n385"><data key="label">Tidsbegrenset bortfall</data><data key="labels">:Kvote</data><data key="navn">Tidsbegrenset bortfall</data><data key="forbrukstype">Sanksjon</data><data key="hjemmel">§ 4-20. Tidsbegrenset bortfall av dagpenger</data></node>
    <node id="n386"><data key="label">Tre meldeperioder uten tilstrekkelig tap</data><data key="labels">:Regelsett</data><data key="navn">Tre meldeperioder uten tilstrekkelig tap</data><data key="type">Vilkår</data><data key="hjemmel">§ 10-4. Tre påfølgende meldeperioder uten tilstrekkelig tap av arbeidstid</data></node>
    <node id="n387"><data key="label">JobbetOverTerskel</data><data key="labels">:Avklaring</data><data key="kode">JobbetOverTerskel</data><data key="tittel">Stans av dagpenger på grunn av arbeid</data><data key="beskrivelse">På de siste tre meldekortene har bruker ført jobb som utgjør mer enn 50 prosent av sin vanlige arbeidstid. Vilkåret om tre påfølgende meldeperioder uten tilstrekkelig tap av arbeidstid etter dagpengeforskriften § 10-4 er ikke oppfylt og dagpenger skal stanses fra og med mandag etter siste innsendte meldekort.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">false</data></node>
    <node id="n388"><data key="label">Uriktige opplysninger og tilbakeholdelse</data><data key="labels">:Regelsett</data><data key="navn">Uriktige opplysninger og tilbakeholdelse</data><data key="type">Vilkår</data><data key="hjemmel">§ 21-7. Uriktige opplysninger m.m. - følger for ytelser fra trygden</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§21-7</data></node>
    <node id="n389"><data key="label">Utdanning</data><data key="labels">:Regelsett</data><data key="navn">Utdanning</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-6. Dagpenger under utdanning, opplæring, etablering av egen virksomhet m.v</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-6</data></node>
    <node id="n390"><data key="label">MeldekortMedUtdanning</data><data key="labels">:Avklaring</data><data key="kode">MeldekortMedUtdanning</data><data key="tittel">Meldekort med utdanning eller tiltak</data><data key="beskrivelse">Bruker har krysset av for utdanning eller tiltak på meldekortet. Må vurderes manuelt. 
Husk å sjekke om det er godkjent arbeidsmarkedstiltak i Arena.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n391"><data key="label">Utestengning</data><data key="labels">:Regelsett</data><data key="navn">Utestengning</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-28. Utestengning</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-28</data></node>
    <node id="n392"><data key="label">Utestengt</data><data key="labels">:Avklaring</data><data key="kode">Utestengt</data><data key="tittel">Bruker er utestengt</data><data key="beskrivelse">Bruker er utestengt. Sjekk at dette stemmer.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n393"><data key="label">Fastsettelse av arbeidstid</data><data key="labels">:Regelsett</data><data key="navn">Fastsettelse av arbeidstid</data><data key="type">Fastsettelse</data><data key="hjemmel">§ 4-3. Fastsettelse av arbeidstid</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-3</data></node>
    <node id="n394"><data key="label">Verneplikt</data><data key="labels">:Regelsett</data><data key="navn">Verneplikt</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-19. Dagpenger etter avtjent verneplikt</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-19</data></node>
    <node id="n395"><data key="label">Verneplikt</data><data key="labels">:Avklaring</data><data key="kode">Verneplikt</data><data key="tittel">Verneplikt</data><data key="beskrivelse">Søker har svart ja på avtjent verneplikt i søknaden. 
Vurder om kravet til dagpenger ved avtjent verneplikt er oppfylt.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
