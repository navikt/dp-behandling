    <node id="n669"><data key="label">Fulle ytelser</data><data key="labels">:Regelsett</data><data key="navn">Fulle ytelser</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-24. Medlem som har fulle ytelser etter folketrygdloven eller avtalefestet pensjon</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-24</data></node>
    <node id="n670"><data key="label">FulleYtelser</data><data key="labels">:Avklaring</data><data key="kode">FulleYtelser</data><data key="tittel">Andre fulle ytelser etter folketrygdloven</data><data key="beskrivelse">Sjekk om søker har andre fulle ytelser. 
Om søker har andre fulle ytelser, må det velges mellom dagpenger eller disse ytelsene.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n671"><data key="label">Gjenopptak</data><data key="labels">:Regelsett</data><data key="navn">Gjenopptak</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-16. Gjenopptak av løpende stønadsperiode</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-16</data></node>
