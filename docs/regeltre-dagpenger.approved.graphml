    <node id="n369"><data key="label">Samordning utenfor folketrygden</data><data key="labels">:Regelsett</data><data key="navn">Samordning utenfor folketrygden</data><data key="type">Fastsettelse</data><data key="hjemmel">§ 4-26. Samordning med ytelser utenfor folketrygden</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-26</data></node>
    <node id="n370"><data key="label">YtelserUtenforFolketrygden</data><data key="labels">:Avklaring</data><data key="kode">YtelserUtenforFolketrygden</data><data key="tittel">Ytelser utenfor folketrygden</data><data key="beskrivelse">Søker har oppgitt i søknaden at hen mottar ytelser utenfor folketrygden.
Sjekk hvilke ytelser som er oppgitt utenfor folketrygden og om dette har konsekvenser for dagpengene.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n371"><data key="label">Samordning reduserte ytelser</data><data key="labels">:Regelsett</data><data key="navn">Samordning reduserte ytelser</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-25. Samordning med reduserte ytelser fra folketrygden, eller redusert avtalefestet pensjon</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-25</data></node>
    <node id="n372"><data key="label">Samordning</data><data key="labels">:Avklaring</data><data key="kode">Samordning</data><data key="tittel">Samordning</data><data key="beskrivelse">Vi har funnet andre ytelser fra folketrygden. 
Vurder om, og eventuelt hvordan, de skal samordnes med dagpengene.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
