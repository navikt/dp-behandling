    <node id="n331"><data key="label">FulleYtelser</data><data key="labels">:Avklaring</data><data key="kode">FulleYtelser</data><data key="tittel">Andre fulle ytelser etter folketrygdloven</data><data key="beskrivelse">Sjekk om søker har andre fulle ytelser. 
