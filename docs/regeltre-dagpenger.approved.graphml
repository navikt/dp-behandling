    <node id="n374"><data key="label">OppgirSelvforskyldtArbeidsløshet</data><data key="labels">:Avklaring</data><data key="kode">OppgirSelvforskyldtArbeidsløshet</data><data key="tittel">Bruker oppgir selvforskyldt arbeidsløshet</data><data key="beskrivelse">Bruker oppgir selvforskyldt arbeidsløshet i søknaden. Sjekk at dette stemmer.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
