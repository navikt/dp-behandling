    <node id="n690"><data key="label">Permittering fiskeindustri</data><data key="labels">:Regelsett</data><data key="navn">Permittering fiskeindustri</data><data key="type">Vilkår</data><data key="hjemmel">§ 6-7. Permittering i fiskeforedlingsindustrien, sjømatindustrien og fiskeoljeindustrien</data></node>
    <node id="n691"><data key="label">HarOppgittPermitteringFiskeindustri</data><data key="labels">:Avklaring</data><data key="kode">HarOppgittPermitteringFiskeindustri</data><data key="tittel">Permittering fiskeindustri</data><data key="beskrivelse">Søker har oppgitt permittering fra fiskeindustri i søknaden. 
Vurder om søker er permittert og har rett til dagpenger som permittert fra fiskeindustrien.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n692"><data key="label">Permittering fiskeindustri</data><data key="labels">:Regelsett</data><data key="navn">Permittering fiskeindustri</data><data key="type">Fastsettelse</data><data key="hjemmel">§ 6-7. Permittering i fiskeforedlingsindustrien, sjømatindustrien og fiskeoljeindustrien</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§6-7</data></node>
    <node id="n693"><data key="label">Reell arbeidssøker</data><data key="labels">:Regelsett</data><data key="navn">Reell arbeidssøker</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-5. Reelle arbeidssøkere</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-5</data></node>
    <node id="n694"><data key="label">ReellArbeidssøkerUnntak</data><data key="labels">:Avklaring</data><data key="kode">ReellArbeidssøkerUnntak</data><data key="tittel">Unntak til å være reell arbeidssøker</data><data key="beskrivelse">Vurder om søker fyller unntakene til reell arbeidssøker.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n695"><data key="label">IkkeRegistrertSomArbeidsøker</data><data key="labels">:Avklaring</data><data key="kode">IkkeRegistrertSomArbeidsøker</data><data key="tittel">Ikke registrert som arbeidssøker</data><data key="beskrivelse">Søker er ikke registrert som arbeidssøker på søknadstidspunktet.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n696"><data key="label">Registrert som arbeidssøker</data><data key="labels">:Regelsett</data><data key="navn">Registrert som arbeidssøker</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-5. Reelle arbeidssøkere - registrert som arbeidssøker</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-5</data></node>
    <node id="n697"><data key="label">Rettighetstype</data><data key="labels">:Regelsett</data><data key="navn">Rettighetstype</data><data key="type">Fastsettelse</data><data key="hjemmel">§ 0-0. Rettighetstype</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§0-0</data></node>
    <node id="n698"><data key="label">Samordning utenfor folketrygden</data><data key="labels">:Regelsett</data><data key="navn">Samordning utenfor folketrygden</data><data key="type">Fastsettelse</data><data key="hjemmel">§ 4-26. Samordning med ytelser utenfor folketrygden</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-26</data></node>
    <node id="n699"><data key="label">YtelserUtenforFolketrygden</data><data key="labels">:Avklaring</data><data key="kode">YtelserUtenforFolketrygden</data><data key="tittel">Ytelser utenfor folketrygden</data><data key="beskrivelse">Søker har oppgitt i søknaden at hen mottar ytelser utenfor folketrygden.
Sjekk hvilke ytelser som er oppgitt utenfor folketrygden og om dette har konsekvenser for dagpengene.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n700"><data key="label">Samordning reduserte ytelser</data><data key="labels">:Regelsett</data><data key="navn">Samordning reduserte ytelser</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-25. Samordning med reduserte ytelser fra folketrygden, eller redusert avtalefestet pensjon</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-25</data></node>
    <node id="n701"><data key="label">Samordning</data><data key="labels">:Avklaring</data><data key="kode">Samordning</data><data key="tittel">Samordning</data><data key="beskrivelse">Vi har funnet andre ytelser fra folketrygden. 
Vurder om, og eventuelt hvordan, de skal samordnes med dagpengene.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n702"><data key="label">Sanksjonsperiode</data><data key="labels">:Regelsett</data><data key="navn">Sanksjonsperiode</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-10. Sanksjonsperiode ved selvforskyldt arbeidsløshet</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-10</data></node>
    <node id="n703"><data key="label">OppgirSelvforskyldtArbeidsløshet</data><data key="labels">:Avklaring</data><data key="kode">OppgirSelvforskyldtArbeidsløshet</data><data key="tittel">Bruker oppgir selvforskyldt arbeidsløshet</data><data key="beskrivelse">Bruker oppgir selvforskyldt arbeidsløshet i søknaden. Sjekk at dette stemmer.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n704"><data key="label">Sanksjonsperiode</data><data key="labels">:Kvote</data><data key="navn">Sanksjonsperiode</data><data key="forbrukstype">Sanksjon</data><data key="hjemmel">§ 4-10. Sanksjonsperiode ved selvforskyldt arbeidsløshet</data></node>
    <node id="n705"><data key="label">Streik og lock-out</data><data key="labels">:Regelsett</data><data key="navn">Streik og lock-out</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-22. Bortfall ved streik og lock-out</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-22</data></node>
    <node id="n706"><data key="label">Søknad</data><data key="labels">:Regelsett</data><data key="navn">Søknad</data><data key="type">Vilkår</data><data key="hjemmel">§ 22-13. Frister for framsetting av krav, virkningstidspunkt og etterbetaling</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§22-13</data></node>
    <node id="n707"><data key="label">Søknadstidspunkt</data><data key="labels">:Regelsett</data><data key="navn">Søknadstidspunkt</data><data key="type">Fastsettelse</data><data key="hjemmel">§ 3-1. Søknadstidspunkt</data></node>
    <node id="n708"><data key="label">VirkningstidspunktForLangtFramItid</data><data key="labels">:Avklaring</data><data key="kode">VirkningstidspunktForLangtFramItid</data><data key="tittel">Prøvingsdato ligger for langt fram i tid</data><data key="beskrivelse">Prøvingsdato ligger mer enn 14 dager fram i tid.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n709"><data key="label">SjekkPrøvingsdato</data><data key="labels">:Avklaring</data><data key="kode">SjekkPrøvingsdato</data><data key="tittel">Prøvingsdato</data><data key="beskrivelse">Sjekk at valgt prøvingsdato er riktig.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n710"><data key="label">Tap av arbeidsinntekt og arbeidstid</data><data key="labels">:Regelsett</data><data key="navn">Tap av arbeidsinntekt og arbeidstid</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-3. Tap av arbeidsinntekt og arbeidstid</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-3</data></node>
    <node id="n711"><data key="label">TapAvArbeidsinntektOgArbeidstid</data><data key="labels">:Avklaring</data><data key="kode">TapAvArbeidsinntektOgArbeidstid</data><data key="tittel">Du må velge kun én beregningsregel for tap av arbeidsinntekt og arbeidstid</data><data key="beskrivelse">Kun én beregningsregel kan være gyldig til enhver tid. 
Velg en av &quot;Arbeidstid siste 6 måneder&quot;, &quot;Arbeidstid siste 12 måneder&quot; eller &quot;Arbeidstid siste 36 måneder&quot;.</data><data key="kanKvitteres">false</data><data key="kanAvbrytes">true</data></node>
    <node id="n712"><data key="label">BeregnetArbeidstid</data><data key="labels">:Avklaring</data><data key="kode">BeregnetArbeidstid</data><data key="tittel">Arbeidstid</data><data key="beskrivelse">Sjekk om vanlig arbeidstid er korrekt og at det er brukt riktig beregningsregel. 
Du må også sjekke om ny vanlig arbeidstid er korrekt.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n713"><data key="label">Tidsbegrenset bortfall</data><data key="labels">:Regelsett</data><data key="navn">Tidsbegrenset bortfall</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-20. Tidsbegrenset bortfall av dagpenger</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-20</data></node>
    <node id="n714"><data key="label">Tidsbegrenset bortfall</data><data key="labels">:Kvote</data><data key="navn">Tidsbegrenset bortfall</data><data key="forbrukstype">Sanksjon</data><data key="hjemmel">§ 4-20. Tidsbegrenset bortfall av dagpenger</data></node>
    <node id="n715"><data key="label">Tre meldeperioder uten tilstrekkelig tap</data><data key="labels">:Regelsett</data><data key="navn">Tre meldeperioder uten tilstrekkelig tap</data><data key="type">Vilkår</data><data key="hjemmel">§ 10-4. Tre påfølgende meldeperioder uten tilstrekkelig tap av arbeidstid</data></node>
    <node id="n716"><data key="label">JobbetOverTerskel</data><data key="labels">:Avklaring</data><data key="kode">JobbetOverTerskel</data><data key="tittel">Stans av dagpenger på grunn av arbeid</data><data key="beskrivelse">På de siste tre meldekortene har bruker ført jobb som utgjør mer enn 50 prosent av sin vanlige arbeidstid. Vilkåret om tre påfølgende meldeperioder uten tilstrekkelig tap av arbeidstid etter dagpengeforskriften § 10-4 er ikke oppfylt og dagpenger skal stanses fra og med mandag etter siste innsendte meldekort.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">false</data></node>
    <node id="n717"><data key="label">Uriktige opplysninger og tilbakeholdelse</data><data key="labels">:Regelsett</data><data key="navn">Uriktige opplysninger og tilbakeholdelse</data><data key="type">Vilkår</data><data key="hjemmel">§ 21-7. Uriktige opplysninger m.m. - følger for ytelser fra trygden</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§21-7</data></node>
    <node id="n718"><data key="label">Utdanning</data><data key="labels">:Regelsett</data><data key="navn">Utdanning</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-6. Dagpenger under utdanning, opplæring, etablering av egen virksomhet m.v</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-6</data></node>
    <node id="n719"><data key="label">MeldekortMedUtdanning</data><data key="labels">:Avklaring</data><data key="kode">MeldekortMedUtdanning</data><data key="tittel">Meldekort med utdanning eller tiltak</data><data key="beskrivelse">Bruker har krysset av for utdanning eller tiltak på meldekortet. Må vurderes manuelt. 
Husk å sjekke om det er godkjent arbeidsmarkedstiltak i Arena.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n720"><data key="label">Utestengning</data><data key="labels">:Regelsett</data><data key="navn">Utestengning</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-28. Utestengning</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-28</data></node>
    <node id="n721"><data key="label">Utestengt</data><data key="labels">:Avklaring</data><data key="kode">Utestengt</data><data key="tittel">Bruker er utestengt</data><data key="beskrivelse">Bruker er utestengt. Sjekk at dette stemmer.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n722"><data key="label">Fastsettelse av arbeidstid</data><data key="labels">:Regelsett</data><data key="navn">Fastsettelse av arbeidstid</data><data key="type">Fastsettelse</data><data key="hjemmel">§ 4-3. Fastsettelse av arbeidstid</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-3</data></node>
    <node id="n723"><data key="label">Verneplikt</data><data key="labels">:Regelsett</data><data key="navn">Verneplikt</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-19. Dagpenger etter avtjent verneplikt</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-19</data></node>
    <node id="n724"><data key="label">Verneplikt</data><data key="labels">:Avklaring</data><data key="kode">Verneplikt</data><data key="tittel">Verneplikt</data><data key="beskrivelse">Søker har svart ja på avtjent verneplikt i søknaden. 
Vurder om kravet til dagpenger ved avtjent verneplikt er oppfylt.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n725"><data key="label">Dagpenger ved verneplikt</data><data key="labels">:Regelsett</data><data key="navn">Dagpenger ved verneplikt</data><data key="type">Fastsettelse</data><data key="hjemmel">§ 4-19. Dagpenger etter avtjent verneplikt</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-19</data></node>
