    <node id="n674"><data key="label">Medlemmets opplysningsplikt</data><data key="labels">:Regelsett</data><data key="navn">Medlemmets opplysningsplikt</data><data key="type">Vilkår</data><data key="hjemmel">§ 21-3. Medlemmets opplysningsplikt</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§21-3</data></node>
    <node id="n675"><data key="label">Meldeplikt</data><data key="labels">:Regelsett</data><data key="navn">Meldeplikt</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-8. Meldeplikt og møteplikt</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-8</data></node>
    <node id="n676"><data key="label">Minsteinntekt</data><data key="labels">:Regelsett</data><data key="navn">Minsteinntekt</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-4. Krav til minsteinntekt</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-4</data></node>
    <node id="n677"><data key="label">SvangerskapsrelaterteSykepenger</data><data key="labels">:Avklaring</data><data key="kode">SvangerskapsrelaterteSykepenger</data><data key="tittel">Svangerskapsrelaterte sykepenger</data><data key="beskrivelse">Søker har fått utbetalt sykepenger. Sjekk om sykepengene er svangerskapsrelaterte, 
og skal være med i inntektsgrunnlaget for vurderingen av minste arbeidsinntekt.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n678"><data key="label">InntektNesteKalendermåned</data><data key="labels">:Avklaring</data><data key="kode">InntektNesteKalendermåned</data><data key="tittel">Inntekt neste måned</data><data key="beskrivelse">Søker har inntekt som tilhører neste kalendermåned. 
Sjekk om det er tilstrekkelige inntekter til at utfallet eller dagpengegrunnlaget vil endre seg i neste kalendermåned.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n679"><data key="label">Omgjøring uten klage</data><data key="labels">:Regelsett</data><data key="navn">Omgjøring uten klage</data><data key="type">Prosess</data><data key="hjemmel">§ 6-35. Omgjøring av vedtak uten klage</data><data key="hjemmelUrl">https://lovdata.no/nav/andre-rettskilder/Forvaltningsloven/kapVI/§6-35</data></node>
    <node id="n680"><data key="label">HarSvartPåOmgjøringUtenKlage</data><data key="labels">:Avklaring</data><data key="kode">HarSvartPåOmgjøringUtenKlage</data><data key="tittel">Omgjøring etter forvaltningsloven § 35</data><data key="beskrivelse">Du må velge aktuell bokstav i forvaltningsloven § 35, og begrunne. Trykk på linken for å komme til prosessregler og gi begrunnelse.</data><data key="kanKvitteres">false</data><data key="kanAvbrytes">true</data></node>
    <node id="n681"><data key="label">Skal omgjøring uten klage vurderes?</data><data key="labels">:Regelsett</data><data key="navn">Skal omgjøring uten klage vurderes?</data><data key="type">Prosess</data><data key="hjemmel">§ 6-35. Skal omgjøring uten klage vurderes?</data><data key="hjemmelUrl">https://lovdata.no/nav/andre-rettskilder/Forvaltningsloven/kapVI/§6-35</data></node>
    <node id="n682"><data key="label">SkalOmgjøringUtenKlageVurderes</data><data key="labels">:Avklaring</data><data key="kode">SkalOmgjøringUtenKlageVurderes</data><data key="tittel">Skal vedtaket omgjøres etter forvaltningsloven § 35?</data><data key="beskrivelse">Hvis du ikke skal omgjøre etter forvaltningsloven § 35, må du begrunne hvorfor for å lukke avklaringen. 
Hvis du skal omgjøre må du klikke på linken og velge årsak til omgjøringen.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n683"><data key="label">Opphold</data><data key="labels">:Regelsett</data><data key="navn">Opphold</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-2. Opphold i Norge</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-2</data></node>
    <node id="n684"><data key="label">Bostedsland</data><data key="labels">:Avklaring</data><data key="kode">Bostedsland</data><data key="tittel">Bostedsland er ikke Norge</data><data key="beskrivelse">Søker har oppgitt bostedsland som ikke er i Norge.
Sjekk om bruker er unntatt vilkårene for opphold i Norge.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n685"><data key="label">Opptjeningsperiode</data><data key="labels">:Regelsett</data><data key="navn">Opptjeningsperiode</data><data key="type">Fastsettelse</data><data key="hjemmel">§ 1-2. Frist for levering av opplysninger</data></node>
    <node id="n686"><data key="label">Permittering</data><data key="labels">:Regelsett</data><data key="navn">Permittering</data><data key="type">Vilkår</data><data key="hjemmel">§ 4-7. Dagpenger til permitterte</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-7</data></node>
    <node id="n687"><data key="label">HarOppgittPermittering</data><data key="labels">:Avklaring</data><data key="kode">HarOppgittPermittering</data><data key="tittel">Permittering</data><data key="beskrivelse">Søker har oppgitt permittering i søknaden. Vurder om søker er permittert og har rett til dagpenger som permittert.</data><data key="kanKvitteres">true</data><data key="kanAvbrytes">true</data></node>
    <node id="n688"><data key="label">Permittering (fastsettelse)</data><data key="labels">:Regelsett</data><data key="navn">Permittering (fastsettelse)</data><data key="type">Fastsettelse</data><data key="hjemmel">§ 4-7. Dagpenger til permitterte</data><data key="hjemmelUrl">https://lovdata.no/nav/lov/1997-02-28-19/§4-7</data></node>
